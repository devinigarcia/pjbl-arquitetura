# Usado só pelo docker-compose.yml (ambiente local). Copie para ".env" — o .env não vai para o Git.

# Senha do usuário "sa" do SQL Server local. Precisa ter maiúscula, minúscula, número e símbolo.
# Troque por uma senha sua; este valor é só um exemplo para ambiente de desenvolvimento.
MSSQL_SA_PASSWORD=Troque_Esta_Senha_123

# Chaves internas (x-api-key) dos microserviços. Vazio = desligado, que é o mais prático localmente.
PRODUTOS_API_KEY=
PEDIDOS_API_KEY=
